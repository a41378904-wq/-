<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>لوحة تحكم البوت</title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #23272a; color: white; display: flex; justify-content: center; align-items: center; min-height: 100vh; margin: 0; }
        .container { background-color: #2c2f33; padding: 30px; border-radius: 10px; box-shadow: 0 4px 15px rgba(0,0,0,0.5); width: 400px; }
        h1 { text-align: center; color: #7289da; margin-bottom: 30px; }
        .setting-group { margin-bottom: 20px; }
        label { display: block; margin-bottom: 8px; font-weight: bold; color: #b9bbbe; }
        input[type="text"], select { width: 100%; padding: 10px; border-radius: 5px; border: none; background-color: #40444b; color: white; box-sizing: border-box; }
        .btn { width: 100%; padding: 12px; border: none; border-radius: 5px; background-color: #7289da; color: white; font-size: 16px; font-weight: bold; cursor: pointer; transition: background-color 0.3s; margin-top: 10px; }
        .btn:hover { background-color: #5b6eae; }
    </style>
</head>
<body>
    <div class="container">
        <h1>⚙️ الإعدادات</h1>
        <form action="/update" method="POST">
            
            <div class="setting-group">
                <label>البريفكس (Prefix)</label>
                <input type="text" name="value" value="<%= settings.prefix %>">
                <input type="hidden" name="key" value="prefix">
            </div>

            <div class="setting-group">
                <label>حالة البوت (Status Text)</label>
                <input type="text" name="value" value="<%= settings.status.text %>">
                <input type="hidden" name="key" value="status_text">
            </div>

            <div class="setting-group">
                <label>رسالة الترحيب</label>
                 <input type="text" name="value" value="<%= settings.welcome_message %>">
                <input type="hidden" name="key" value="welcome_message">
            </div>

            <div class="setting-group">
                <label>تفعيل الحماية (Auto-Mod)</label>
                <select name="value">
                    <option value="true" <%= settings.auto_mod_enabled ? 'selected' : '' %>>مفعل ✅</option>
                    <option value="false" <%= !settings.auto_mod_enabled ? 'selected' : '' %>>معطل ❌</option>
                </select>
                <input type="hidden" name="key" value="auto_mod_enabled">
            </div>

            <button type="submit" class="btn">حفظ التغييرات</button>
        </form>
    </div>
</body>
</html>
