<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>لوحة تحكم البوت</title>
    <style>
        :root {
            --primary-red: #ff0000;
            --dark-red: #8b0000;
            --bg-black: #0a0a0a;
            --card-bg: #1a0505;
            --text-gray: #b9bbbe;
        }

        body { 
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
            background-color: var(--bg-black); 
            color: white; 
            margin: 0; 
            display: flex; 
            justify-content: center; 
            align-items: center; 
            min-height: 100vh; 
        }

        .container { 
            background-color: var(--card-bg); 
            width: 450px; 
            border-radius: 15px; 
            box-shadow: 0 0 25px rgba(255, 0, 0, 0.3); 
            overflow: hidden;
            margin-top: 50px;
            margin-bottom: 50px;
        }

        .banner {
            width: 100%;
            height: 150px;
            object-fit: cover;
            border-bottom: 3px solid var(--primary-red);
        }

        .profile-section {
            display: flex;
            flex-direction: column;
            align-items: center;
            margin-top: -50px;
            margin-bottom: 20px;
        }

        .profile-pic {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            border: 4px solid var(--card-bg);
            object-fit: cover;
            box-shadow: 0 0 15px var(--primary-red);
        }

        .content { padding: 20px 30px; }

        h1 { text-align: center; color: var(--primary-red); margin-bottom: 30px; }
        
        .setting-group { margin-bottom: 20px; }
        
        label { display: block; margin-bottom: 8px; font-weight: bold; color: var(--text-gray); }
        
        input[type="text"], select { 
            width: 100%;
            padding: 10px; 
            border-radius: 5px; 
            border: none; 
            background-color: #40444b; 
            color: white; 
            box-sizing: border-box; 
        }

        .btn { 
            width: 100%; 
            padding: 12px; 
            border: none; 
            border-radius: 5px; 
            background-color: var(--primary-red); 
            color: white; 
            font-size: 16px; 
            font-weight: bold; 
            cursor: pointer; 
            transition: background-color 0.3s; 
            margin-top: 10px; 
        }

        .btn:hover { background-color: var(--dark-red); }
    </style>
</head>
<body dir="rtl">
    <div class="container">
        <!-- البنر -->
        <img src="https://cdn.discordapp.com/banners/1527528608254656562/c6ab17e1a31379b98d4d37c42bda2db9.webp?size=1024" class="banner" alt="Banner">

        <div class="profile-section">
            <!-- الصورة الشخصية -->
            <img src="https://cdn.discordapp.com/avatars/1527528608254656562/8eff93064f25c7819b89b03b431d6126.webp?size=4096" class="profile-pic" alt="Profile">
        </div>

        <div class="content">
            <h1>⚙️ الإعدادات</h1>
            <form action="/update" method="POST">
                
                <div class="setting-group">
                    <label>البريفكس (Prefix)</label>
                    <input type="text" name="prefix" value="<%= settings.prefix %>">
                </div>

                <div class="setting-group">
                    <label>حالة البوت (Status Text)</label>
                    <input type="text" name="status_text" value="<%= settings.status.text %>">
                </div>

                <div class="setting-group">
                    <label>رسالة الترحيب</label>
                    <input type="text" name="welcome_message" value="<%= settings.welcome_message %>">
                </div>

                <div class="setting-group">
                <label>تفعيل الحماية (Auto-Mod)</label>
                    <select name="auto_mod_enabled">
                        <option value="true" <%= settings.auto_mod_enabled ? 'selected' : '' %>>مفعل ✅</option>
                        <option value="false" <%= !settings.auto_mod_enabled ? 'selected' : '' %>>معطل ❌</option>
                    </select>
                </div>

                <button type="submit" class="btn">حفظ التغييرات</button>
            </form>
        </div>
    </div>
</body>
</html>
